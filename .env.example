# Telegram
NOTIFYGATE_TELEGRAM_BOT_TOKEN=
NOTIFYGATE_TELEGRAM_CHAT_ID=
NOTIFYGATE_TELEGRAM_THREAD_ID=   # forum topic ise message_thread_id (varsayılan hedef)

# Topic yönlendirme: {"topic_adi": "thread_id"} — event.topic buradan çözülür;
# eşleşme yoksa varsayılan thread kullanılır.
NOTIFYGATE_ROUTES={"project_a":"4721"}

# Slack (opsiyonel) — Incoming Webhook URL'si; doluysa teslimatlar
# Telegram'a EK OLARAK bu kanala da gider.
NOTIFYGATE_SLACK_WEBHOOK_URL=
# Thread modu (opsiyonel) — Slack app bot token'ı (chat:write). Webhook'tan
# üstün: her topic kendi Slack thread'inde birikir.
NOTIFYGATE_SLACK_TOKEN=
NOTIFYGATE_SLACK_CHANNEL=

# Thread -> Telegram topic adı (UI'da isim gösterimi için)
NOTIFYGATE_THREAD_NAMES={"4721":"Project A","4722":"Project B"}

# Hermes hooks.outbound imza doğrulaması — Hermes .env'indeki
# HERMES_OUTBOUND_WEBHOOK_SECRET ile AYNI değer olmalı. Boşsa imza atlanır.
NOTIFYGATE_HERMES_SECRET=

# İstatistik DB yolu (SQLite, proje köküne göre)
NOTIFYGATE_DB_PATH=data/notifygate.db

# Rules
NOTIFYGATE_QUIET_START=23
NOTIFYGATE_QUIET_END=8
NOTIFYGATE_QUIET_ALLOW=critical
NOTIFYGATE_DEDUPE_WINDOW_SECONDS=300
NOTIFYGATE_DIGEST_INTERVAL_SECONDS=300
NOTIFYGATE_DIGEST_MAX_EVENTS=20
